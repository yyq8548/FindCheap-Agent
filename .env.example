# Awin Product Feed service. Never commit the real URL or token.
AWIN_SOURCE_FEED_URL=https://productdata.awin.com/datafeed/download/REPLACE_WITH_PRIVATE_PATH
AWIN_SOURCE_ALLOWED_HOSTS=productdata.awin.com,datafeed.api.productserve.com
