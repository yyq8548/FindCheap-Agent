# Awin Product Feed service. Never commit the real URL or token.
# Preferred: one private Feed List URL discovers every joined US English Feed.
AWIN_SOURCE_FEED_LIST_URL=https://ui.awin.com/REPLACE_WITH_PRIVATE_FEED_LIST_PATH
AWIN_SOURCE_FEED_REGION=US
AWIN_SOURCE_FEED_LANGUAGE=English
# Optional fallback for deployments that do not use a Feed List.
AWIN_SOURCE_FEED_URL=https://productdata.awin.com/datafeed/download/REPLACE_WITH_PRIVATE_PATH
# Continue with _3 through _10 only in direct-URL fallback mode.
AWIN_SOURCE_FEED_URL_2=
AWIN_SOURCE_FEED_URL_3=
AWIN_SOURCE_ALLOWED_HOSTS=productdata.awin.com,datafeed.api.productserve.com,ui.awin.com
AWIN_FEED_API_TOKEN=replace-with-at-least-32-random-characters
AWIN_REFRESH_INTERVAL_MINUTES=360
AWIN_SOURCE_TIMEOUT_MS=15000
AWIN_PRODUCT_SEARCH_URL=https://findcheap-agent-production.up.railway.app/v1/search
AWIN_PRODUCT_SEARCH_TIMEOUT_MS=5000
AWIN_OFFERS_SEARCH_URL=https://findcheap-agent-production.up.railway.app/v1/offers/search

# Optional eBay Browse gateway. SANDBOX uses sandbox credentials and never adds EPN tracking.
EBAY_BROWSE_ENABLED=false
EBAY_ENVIRONMENT=PRODUCTION
EBAY_CLIENT_ID=replace-with-private-ebay-client-id
EBAY_CLIENT_SECRET=replace-with-private-ebay-client-secret
EBAY_EPN_CAMPAIGN_ID=replace-with-numeric-campaign-id
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_BROWSE_TIMEOUT_MS=5000
EBAY_BROWSE_CACHE_SECONDS=60
EBAY_PRODUCT_SEARCH_URL=https://findcheap-agent-production.up.railway.app/v1/ebay/search
EBAY_PRODUCT_SEARCH_TIMEOUT_MS=5000

# Optional Awin Promotions API cache in the Railway Feed service.
AWIN_API_TOKEN=replace-with-your-private-publisher-api-token
AWIN_PUBLISHER_ID=3047955
AWIN_OFFERS_DATA_PATH=/data/offers.json
AWIN_OFFERS_REFRESH_INTERVAL_MINUTES=60
AWIN_OFFERS_TIMEOUT_MS=15000
